# ========================================================
# NEXUS AI - Environment Configuration Template
# Amazon Developer Hackathon 2026 (Track: Alexa+)
# ========================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# MCP Protocol Configuration
MCP_ENDPOINT=/mcp
MCP_PROTOCOL_VERSION=2025-11-25

# Optional External LLM Credentials
# Nexus AI includes a built-in deterministic multi-tool reasoning engine
# that runs 100% offline out-of-the-box. Providing an API key below enables
# dynamic external model generation.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SQLite Database Location
DATABASE_PATH=./data/nexusai.db
UPLOADS_DIR=./data/uploads
